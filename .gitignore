# 1. Ignore everything in the root
/*

# 2. Allow the directories you want
!/src/
!/public/

# 3. Specifically ignore things inside those allowed folders (optional but standard)
# For example, if you want to keep public/ but ignore uploads inside it:
# /public/uploads/

# 4. Allow specific root files (like package.json) so the project can actually run
!/package.json
!/tsconfig.json
!/.gitignore